<DownloadProgressScreen>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "Downloading…"
            back: True

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(16)
            spacing: dp(8)
            adaptive_height: True

            MDLabel:
                id: title_label
                bold: True
                font_style: "Title"
                role: "small"
                adaptive_height: True
                shorten: True
                shorten_from: "right"
                max_lines: 1

            MDLinearProgressIndicator:
                id: progress_bar
                value: 0
                max: 1

            MDLabel:
                id: status_label
                text: ""
                theme_text_color: "Secondary"
                adaptive_height: True

            MDButton:
                id: cancel_btn
                style: "filled"
                size_hint: (1, None)
                height: "40dp"
                opacity: 0
                disabled: True
                on_release: root._cancel()

                MDButtonText:
                    text: "Cancel"
