<SearchTab>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "Search"

        ScrollView:
            always_overscroll: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: (dp(16), 0, dp(16), dp(16))
                spacing: dp(8)

                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: True
                    size_hint: (1, None)
                    spacing: dp(8)

                    MDLabel:
                        id: source_label
                        text: ""
                        theme_text_color: "Secondary"
                        font_style: "Caption"
                        size_hint_y: None
                        height: dp(48)
                        valign: "top"
                        text_size: (None, dp(48))

                    MDIconButton:
                        id: source_btn
                        icon: "swap-horizontal"
                        size_hint: (None, None)
                        size: (dp(40), dp(32))
                        on_release: root._open_source_picker()

                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: True
                    size_hint: (1, None)
                    spacing: dp(8)

                    MDTextField:
                        id: search_field
                        hint_text: "Search novels…"
                        mode: "round"
                        icon_left: "magnify"
                        size_hint: (1, None)
                        height: "56dp"
                        on_text_validate: root._on_enter()
                        on_text: root._on_text_changed()

                    MDIconButton:
                        id: clear_btn
                        icon: "close"
                        on_release: root._clear()

                MDBoxLayout:
                    id: browse_box
                    orientation: "vertical"
                    adaptive_height: True

                    BrowseSection:

                MDBoxLayout:
                    id: results_box
                    orientation: "vertical"
                    adaptive_height: True
                    opacity: 0
                    disabled: True

                    MDList:
                        id: results_list