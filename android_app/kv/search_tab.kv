#:import theme screens.theme

<SearchTab>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "Search"

        ScrollView:
            id: scroll_view
            always_overscroll: False
            on_scroll_y: root._on_scroll_y(self.scroll_y)

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: (theme.PAGE_PAD, 0, theme.PAGE_PAD, theme.PAGE_PAD)
                spacing: theme.SECTION_GAP

                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: True
                    size_hint: (1, None)
                    spacing: dp(8)

                    MDLabel:
                        id: source_label
                        text: ""
                        theme_text_color: "Secondary"
                        font_style: "Label"
                        role: "large"
                        size_hint_y: None
                        height: dp(48)
                        valign: "top"
                        text_size: (None, dp(48))
                        shorten: True
                        shorten_from: "right"
                        max_lines: 1

                    MDIconButton:
                        id: source_btn
                        icon: "swap-horizontal"
                        size_hint: (None, None)
                        size: (dp(40), dp(32))
                        on_release: root._open_source_picker()

                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: True
                    size_hint: (1, None)
                    spacing: dp(8)

                    MDTextField:
                        id: search_field
                        hint_text: "Search novels…"
                        mode: "outlined"
                        size_hint: (1, None)
                        height: "56dp"
                        on_text_validate: root._on_enter()
                        on_text: root._on_text_changed()

                        MDTextFieldLeadingIcon:
                            icon: "magnify"

                    MDIconButton:
                        id: clear_btn
                        icon: "close"
                        on_release: root._clear()

                MDLinearProgressIndicator:
                    id: search_progress
                    indeterminate: True
                    opacity: 0
                    size_hint_y: None
                    height: "4dp"

                MDBoxLayout:
                    id: browse_box
                    orientation: "vertical"
                    adaptive_height: True

                    BrowseSection:

                MDBoxLayout:
                    id: results_box
                    orientation: "vertical"
                    adaptive_height: True
                    opacity: 0
                    disabled: True
                    spacing: theme.SECTION_GAP

                    MDLabel:
                        id: result_header
                        text: ""
                        bold: True
                        theme_text_color: "Secondary"
                        font_style: "Title"
                        role: "medium"
                        adaptive_height: True

                    MDLabel:
                        id: result_state_label
                        text: ""
                        theme_text_color: "Secondary"
                        font_style: "Title"
                        role: "medium"
                        adaptive_height: True

                    MDList:
                        id: results_list
                        spacing: dp(2)

                    MDLabel:
                        id: page_footer
                        text: ""
                        theme_text_color: "Secondary"
                        font_style: "Label"
                        role: "large"
                        adaptive_height: True