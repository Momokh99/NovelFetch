#:import theme screens.theme

<SettingsTab>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "Settings"

        ScrollView:
            always_overscroll: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: (theme.PAGE_PAD, 0, theme.PAGE_PAD, theme.PAGE_PAD)
                spacing: theme.SECTION_GAP

                MDLabel:
                    text: "Appearance"
                    bold: True
                    adaptive_height: True

                OneLineAvatarIconListItem:
                    text: "Dark theme"
                    IconLeftWidget:
                        icon: "brightness-4"
                    MDSwitch:
                        id: theme_switch
                        on_active: root._toggle_theme()

                OneLineAvatarIconListItem:
                    id: palette_row
                    text: "Primary color"
                    on_release: root._open_palette()
                    IconLeftWidget:
                        icon: "palette"

                OneLineAvatarIconListItem:
                    id: read_indicator_row
                    text: "Read indicator"
                    on_release: root._open_read_indicator()
                    IconLeftWidget:
                        icon: "progress-check"

                MDLabel:
                    text: "Grid"
                    bold: True
                    adaptive_height: True

                OneLineAvatarIconListItem:
                    id: grid_size_row
                    text: "Card grid size"
                    on_release: root._open_grid_size()
                    IconLeftWidget:
                        icon: "view-comfy"

                OneLineAvatarIconListItem:
                    id: home_layout_row
                    text: "Home layout"
                    on_release: root._open_home_layout()
                    IconLeftWidget:
                        icon: "view-dashboard"

                OneLineAvatarIconListItem:
                    text: "Show continue reading"
                    IconLeftWidget:
                        icon: "bookmark-multiple"
                    MDSwitch:
                        id: continue_reading_switch
                        on_active: root._toggle_continue_reading()

                MDLabel:
                    text: "Library"
                    bold: True
                    adaptive_height: True

                MDLabel:
                    id: library_info
                    text: ""
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    adaptive_height: True

                OneLineAvatarIconListItem:
                    text: "Clear library"
                    on_release: root._confirm_clear()
                    IconLeftWidget:
                        icon: "delete"

                MDLabel:
                    text: "About"
                    bold: True
                    adaptive_height: True

                MDLabel:
                    text: root.about_text
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    adaptive_height: True