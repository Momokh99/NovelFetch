<ChapterListScreen>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "Chapter list"
            back: True

        ScrollView:
            id: scroll_view
            always_overscroll: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True

                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: False
                    padding: theme.PAGE_PAD
                    spacing: theme.PAGE_PAD
                    size_hint_y: None
                    height: "120dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: 1
                        spacing: "2dp"

                        MDLabel:
                            id: title_label
                            text: ""
                            bold: True
                            font_style: "Title"
                            role: "medium"
                            size_hint_y: None
                            height: "32dp"
                            shorten: True
                            shorten_from: "right"
                            max_lines: 2

                        MDLabel:
                            id: info_label
                            text: ""
                            theme_text_color: "Secondary"
                            font_style: "Label"
                            role: "large"
                            size_hint_y: None
                            height: "22dp"

                    AsyncImage:
                        id: cover_img
                        source: ""
                        size_hint: (None, 1)
                        width: "90dp"
                        keep_ratio: True
                        allow_stretch: True

                MDLinearProgressIndicator:
                    id: loading_bar
                    indeterminate: True
                    opacity: 0
                    size_hint_y: None
                    height: "4dp"

                MDButton:
                    id: continue_btn
                    style: "filled"
                    size_hint: (1, None)
                    height: "48dp"

                    MDButtonText:
                        text: "Continue"

                MDButton:
                    id: download_btn
                    style: "filled"
                    size_hint: (1, None)
                    height: "48dp"

                    MDButtonText:
                        text: "Download selected"

                MDList:
                    id: list_view
