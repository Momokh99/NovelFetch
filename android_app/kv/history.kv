#:import theme screens.theme

<HistoryTab>:
    MDBoxLayout:
        orientation: "vertical"

        TopBar:
            id: topbar
            title: "History"

        ScrollView:
            always_overscroll: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: (theme.PAGE_PAD, 0, theme.PAGE_PAD, theme.PAGE_PAD)
                spacing: theme.SECTION_GAP

                MDBoxLayout:
                    id: empty_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: 0
                    padding: dp(16)
                    spacing: dp(4)

                    MDIcon:
                        icon: "history"
                        halign: "center"
                        font_size: "56dp"
                        theme_text_color: "Secondary"

                    MDLabel:
                        text: "No reading history yet"
                        halign: "center"
                        bold: True
                        adaptive_height: True

                    MDLabel:
                        text: "Start reading a novel to build your history."
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_style: "Caption"
                        adaptive_height: True

                MDList:
                    id: list_view
