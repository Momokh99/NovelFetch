# Maintainer: Mohamed <mohamedkhamekhami@gmail.com>
_github='https://github.com/nidhaloff/deep-translator'
pkgname=python-deep-translator
pkgver=1.11.4
pkgrel=1
pkgdesc='A flexible free and unlimited tool to translate between different languages using multiple translators'
arch=('any')
url=$_github
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-poetry-core' 'python-wheel')
source=("deep_translator-$pkgver.tar.gz::https://files.pythonhosted.org/packages/7d/03/8fa7635c729a01de71151894cdf002ad6d245bfd6d1a731da864cf534dcf/deep_translator-$pkgver.tar.gz")
sha256sums=('801260c69231138707ea88a0955e484db7d40e210c9e0ae0f77372ffda5f4bf5')

build() {
    cd "$srcdir/deep_translator-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/deep_translator-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
